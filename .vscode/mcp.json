{
    "servers": {
        "marp-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "@masaki39/marp-mcp@latest",
                "-t",
                "default"
            ]
        },
        "oraios/serena": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "--from",
                "git+https://github.com/oraios/serena",
                "serena",
                "start-mcp-server",
                "--context",
                "ide",
                "--project",
                "${workspaceFolder}"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ],
            "env": {
                "PLAYWRIGHT_BASE_URL": "http://localhost:5173"
            }
        }
    },
    "inputs": []
}